# Sao chép thành .env và điền giá trị riêng. Không commit .env hoặc .env.admin.
# Admin: dùng scripts/setup_admin.py để tạo mật khẩu ngẫu nhiên (ít nhất 16 ký tự).
SERVICEHUB_ADMIN_EMAIL=
SERVICEHUB_ADMIN_PASSWORD=

# Chỉ bật QR khi đã điền đủ thông tin tài khoản nhận trong .env / Render Environment.
SERVICEHUB_ENABLE_BANK_QR=0
# Ví dụ BIN VietinBank: 970415. Không điền thông tin tài khoản thật vào file mẫu.
SERVICEHUB_BANK_BIN=
SERVICEHUB_BANK_ACCOUNT=
SERVICEHUB_BANK_NAME=

# Cổng local; trên Render dùng Start Command: SERVICEHUB_PORT=$PORT python server.py
SERVICEHUB_PORT=8001
SERVICEHUB_HOST_PORT=8001
