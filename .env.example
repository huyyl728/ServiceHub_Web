# Tạo file .env riêng trên máy và điền thông tin thật; KHÔNG commit .env lên Git.
# Mặc định 0: Không cho phép tạo QR có khả năng chuyển tiền thật.
SERVICEHUB_ENABLE_BANK_QR=0
# BIN VietinBank: 970415. Nếu dùng ngân hàng khác, thay mã này.
SERVICEHUB_BANK_BIN=970415
SERVICEHUB_BANK_ACCOUNT=SO_TAI_KHOAN
SERVICEHUB_BANK_NAME="TEN CHU TAI KHOAN"
# Chạy trực tiếp bằng Python trên cổng 8001 (tránh xung đột cổng 8000).
SERVICEHUB_PORT=8001
# Cổng truy cập từ MacBook khi sử dụng Docker Compose.
SERVICEHUB_HOST_PORT=8001
