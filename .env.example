# File mau: cp .env.example .env. Khong commit .env.
# De trong ca hai bien Admin khi chua cau hinh.
# Tao Admin local an toan: python3 scripts/setup_admin.py --email admin@servicehub.local
SERVICEHUB_ADMIN_EMAIL=
SERVICEHUB_ADMIN_PASSWORD=

# Khi chay Python truc tiep
SERVICEHUB_PORT=8001
SERVICEHUB_HOST=127.0.0.1
# Database SQLite duoc tao rieng tren tung may.
# SERVICEHUB_DB_PATH=/duong/dan/den/servicehub.db
